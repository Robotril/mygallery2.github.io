 "narrative": {
  "northStar": "Plasticine Tray",
  "overview": "The interface is made of the same stuff as the world. Every panel, button, card and HUD box is a thick, rounded slab of bright modeling clay with a fine thumbprint grain, a light top edge and a darker pressed underside.",
  "keyCharacteristics": [
   "Bright clay slabs with grain over a live, light 3D scene",
   "Navy ink on every color, never white text on light clay",
   "One color per mode",
   "Rounded display face with a friendly body face, self-hosted",
   "One drawn SVG icon set",
   "Squash and stretch motion"
  ],
  "rules": [
   {
    "name": "The Navy Ink Rule",
    "body": "Text on clay is always ink or ink 2.",
    "section": "colors"
   },
   {
    "name": "The Shade Partner Rule",
    "body": "A slab's underside uses its own color's shade, never a gray.",
    "section": "colors"
   },
   {
    "name": "The Big Screen Rule",
    "body": "Size type for a kid across the room from a big monitor.",
    "section": "typography"
   },
   {
    "name": "The One Layer Rule",
    "body": "A slab never sits inside another slab.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do give every new surface the slab material and set its color and shade together.",
   "Do write copy in short plain sentences a 10-year-old can read.",
   "Do use the SVG icon() set for every icon.",
   "Do keep each mode on its own color everywhere it appears.",
   "Do respect reduced motion."
  ],
  "donts": [
   "Don't make it dark, cluttered or military.",
   "Don't use emoji or Unicode symbols as icons.",
   "Don't put white text on light clay.",
   "Don't nest slabs inside slabs.",
   "Don't add eyebrows or labels above headings.",
   "Don't use gradients as decoration; draw the thing instead.",
   "Don't borrow catchphrases, names or art from other games."
  ]
 }
